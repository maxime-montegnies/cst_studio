---
import { processSteps } from '~/data/process';
---
<section id="methode" class="section methode" data-scene-state="methode">
  <div class="container">
    <header class="methode-header">
      <p class="section-eyebrow" data-reveal>Notre méthode</p>
      <h2 class="section-title" data-reveal data-reveal-delay="0.08">
        COMMENT <span class="section-title-outline">ON TRAVAILLE</span>
      </h2>
      <div class="section-bar" data-reveal data-reveal-delay="0.16"></div>
    </header>

    <ol class="methode-grid">
      {processSteps.map((step, i) => (
        <li
          class="methode-step"
          data-reveal
          data-reveal-delay={(0.08 * i).toFixed(2)}
        >
          <span class="methode-dot" aria-hidden="true"></span>
          <span class="methode-num">{step.num}</span>
          <h3 class="methode-step-title">{step.title}</h3>
          <p class="methode-step-desc">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .methode-header {
    margin-bottom: clamp(48px, 7vw, 72px);
  }

  /* ── Grille des étapes ─────────────────────────── */
  .methode-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--color-border);
    position: relative;
    list-style: none;
  }

  /* Ligne de connexion horizontale au niveau des dots */
  .methode-grid::before {
    content: '';
    position: absolute;
    top: 92px;
    left: 6%;
    right: 6%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(208, 28, 28, 0.25),
      transparent
    );
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .methode-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .methode-grid::before {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .methode-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Step ──────────────────────────────────────── */
  .methode-step {
    padding: clamp(40px, 4vw, 52px) clamp(24px, 3vw, 36px);
    border-right: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
    transition: background 0.45s var(--ease-out);
    text-align: center;
  }
  .methode-step:last-child {
    border-right: none;
  }
  .methode-step:hover {
    background: rgba(26, 26, 31, 0.45);
  }

  @media (max-width: 900px) {
    .methode-step:nth-child(2n) {
      border-right: none;
    }
    .methode-step:nth-child(-n + 2) {
      border-bottom: 1px solid var(--color-border);
    }
  }
  @media (max-width: 560px) {
    .methode-step {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      text-align: left;
    }
    .methode-step:last-child {
      border-bottom: none;
    }
  }

  /* ── Dot ──────────────────────────────────────── */
  .methode-dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-bg-2);
    border: 1px solid rgba(208, 28, 28, 0.5);
    margin: 0 auto 40px;
    position: relative;
    z-index: 1;
    transition: border-color 0.5s, box-shadow 0.5s;
  }
  .methode-dot::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--color-red);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .methode-step:hover .methode-dot {
    border-color: var(--color-red);
    box-shadow: 0 0 16px rgba(208, 28, 28, 0.4);
  }
  .methode-step:hover .methode-dot::after {
    opacity: 1;
  }

  @media (max-width: 560px) {
    .methode-dot {
      margin-left: 0;
      margin-bottom: 24px;
    }
  }

  /* ── Numéro ──────────────────────────────────── */
  .methode-num {
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 4px;
    color: var(--color-red);
    margin-bottom: 22px;
    display: block;
    font-weight: 700;
  }

  /* ── Titre ───────────────────────────────────── */
  .methode-step-title {
    font-family: var(--font-label);
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 14px;
    line-height: 1.3;
    transition: color 0.3s;
  }

  /* ── Description ─────────────────────────────── */
  .methode-step-desc {
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.85;
  }
</style>
