---
import { site } from '~/site.config';
---
<section id="hero" class="hero" data-scene-state="hero">
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-content">
    <p class="hero-eyebrow">{site.tagline}</p>

    <h1 class="hero-title">
      <span class="hero-line">
        <span class="hero-word">VOTRE</span>
        <span class="hero-word">VISION</span>
      </span>
      <span class="hero-line">
        <span class="hero-word hero-word-red">EN</span>
        <span class="hero-word hero-word-outline">IMAGES</span>
      </span>
    </h1>

    <p class="hero-sub">
      Du concept à la livraison, nous transformons vos idées en contenus
      visuels qui captivent, convertissent et marquent les esprits.
    </p>

    <div class="hero-actions">
      <a href="#services" class="btn btn-primary">Découvrir nos services →</a>
      <a href="#contact" class="btn btn-outline">Obtenir un devis</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(560px, 95vh, 920px);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(208, 28, 28, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(208, 28, 28, 0.025) 1px, transparent 1px);
    background-size: 64px 64px;
    animation: gridShift 25s linear infinite;
    pointer-events: none;
  }
  @keyframes gridShift {
    to { background-position: 64px 64px; }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 0 var(--container-padding-x) clamp(48px, 8vw, 88px);
    width: 100%;
    max-width: 1100px;
  }

  .hero-eyebrow {
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 6px;
    text-transform: uppercase;
    color: var(--color-red);
    margin-bottom: 26px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .hero-eyebrow::before {
    content: '';
    width: 36px;
    height: 1px;
    background: var(--color-red);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(56px, 10.5vw, 148px);
    line-height: 0.87;
    letter-spacing: 2px;
    font-weight: 400;
  }
  .hero-line { display: block; }
  .hero-word {
    display: inline-block;
    margin-right: 0.18em;
  }
  .hero-word-red { color: var(--color-red); }
  .hero-word-outline {
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.28);
    color: transparent;
  }

  .hero-sub {
    font-size: clamp(15px, 1.5vw, 17px);
    color: var(--color-muted);
    max-width: 520px;
    line-height: 1.9;
    margin: 32px 0 46px;
  }

  .hero-actions {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 100svh;
    }
    .hero-actions { width: 100%; }
    .hero-actions .btn { flex: 1 1 auto; text-align: center; }
  }
</style>
