---
import { site } from '~/site.config';
---
<section id="showreel" class="section showreel" data-scene-state="showreel">
  <div class="showreel-grid" aria-hidden="true"></div>
  <div class="showreel-vignette" aria-hidden="true"></div>

  <div class="showreel-content">
    <a
      class="showreel-play"
      href={site.social.vimeo}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Voir notre showreel sur Vimeo"
      data-reveal
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <polygon points="5,3 19,12 5,21" />
      </svg>
      <span class="showreel-pulse showreel-pulse-1" aria-hidden="true"></span>
      <span class="showreel-pulse showreel-pulse-2" aria-hidden="true"></span>
      <span class="showreel-pulse showreel-pulse-3" aria-hidden="true"></span>
    </a>

    <h2 class="showreel-title" data-reveal data-reveal-delay="0.12">
      SHOWREEL 2025
    </h2>
    <p class="showreel-sub" data-reveal data-reveal-delay="0.22">
      Voir notre bande démo complète
    </p>
  </div>
</section>

<style>
  .showreel {
    min-height: 68vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
    padding-block: clamp(80px, 12vw, 140px);
  }

  /* Grille subtile en fond de section, dérive lente */
  .showreel-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(208, 28, 28, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(208, 28, 28, 0.04) 1px, transparent 1px);
    background-size: 72px 72px;
    pointer-events: none;
    animation: gridDrift 35s linear infinite;
  }
  @keyframes gridDrift {
    to {
      background-position: -72px -72px;
    }
  }

  .showreel-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      transparent 30%,
      rgba(7, 7, 10, 0.7) 100%
    );
    pointer-events: none;
  }

  .showreel-content {
    position: relative;
    z-index: 2;
    padding: 0 var(--container-padding-x);
  }

  /* ── Bouton play ─────────────────────────────────── */
  .showreel-play {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    border: 1px solid rgba(208, 28, 28, 0.6);
    background: transparent;
    margin: 0 auto 44px;
    transition: background 0.5s var(--ease-out), box-shadow 0.5s,
      transform 0.4s var(--ease-out);
  }
  .showreel-play svg {
    width: 28px;
    height: 28px;
    fill: rgba(208, 28, 28, 0.85);
    margin-left: 6px;
    transition: fill 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .showreel-play:hover {
    background: var(--color-red);
    box-shadow: 0 0 50px rgba(208, 28, 28, 0.45);
  }
  .showreel-play:hover svg {
    fill: var(--color-fg);
    transform: scale(1.1);
  }

  /* Anneaux concentriques pulsants */
  .showreel-pulse {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(208, 28, 28, 0.25);
    pointer-events: none;
  }
  .showreel-pulse-1 {
    inset: -20px;
    animation: showreelPulse 2.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  .showreel-pulse-2 {
    inset: -40px;
    animation: showreelPulse 2.8s cubic-bezier(0.4, 0, 0.6, 1) 0.8s infinite;
  }
  .showreel-pulse-3 {
    inset: -60px;
    animation: showreelPulse 2.8s cubic-bezier(0.4, 0, 0.6, 1) 1.6s infinite;
  }
  @keyframes showreelPulse {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    70%,
    100% {
      transform: scale(1.18);
      opacity: 0;
    }
  }

  /* ── Titre ──────────────────────────────────────── */
  .showreel-title {
    font-family: var(--font-display);
    font-size: clamp(42px, 7vw, 82px);
    letter-spacing: 5px;
    line-height: 1;
    margin-bottom: 16px;
    font-weight: 400;
  }

  .showreel-sub {
    font-size: 11px;
    color: var(--color-muted-2);
    letter-spacing: 4px;
    font-family: var(--font-label);
    text-transform: uppercase;
  }
</style>
