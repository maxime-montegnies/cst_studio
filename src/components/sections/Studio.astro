---
import { features } from '~/data/features';
import { stats } from '~/data/stats';
import { testimonials } from '~/data/testimonials';
import { clients } from '~/data/clients';
---
<section id="studio" class="section studio" data-scene-state="studio">
  <div class="container">
    {/* ── Header ─────────────────────────────────────── */}
    <header class="studio-header">
      <p class="section-eyebrow" data-reveal>Pourquoi CST Studio</p>
      <h2 class="section-title" data-reveal data-reveal-delay="0.08">
        UNE AGENCE <span class="section-title-outline">QUI LIVRE</span>
      </h2>
      <div class="section-bar" data-reveal data-reveal-delay="0.16"></div>
    </header>

    {/* ── Split : intro+features / stats ─────────────── */}
    <div class="studio-split">
      <div class="studio-pitch">
        <p class="studio-intro" data-reveal>
          Basé à Metz, au cœur du Grand Est, CST Studio est un studio de production
          audiovisuelle à taille humaine. Chaque projet reçoit une attention totale —
          du brief à la livraison finale, en passant par la stratégie de diffusion.
        </p>

        <ul class="studio-features">
          {features.map((feature, i) => (
            <li
              class="studio-feature"
              data-reveal
              data-reveal-delay={(0.06 * i).toFixed(2)}
            >
              <span class="studio-feature-num">{feature.num}</span>
              <div>
                <h3 class="studio-feature-title">{feature.title}</h3>
                <p class="studio-feature-desc">{feature.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="studio-stats">
        {stats.map((stat, i) => (
          <div
            class="studio-stat"
            data-reveal
            data-reveal-delay={(0.08 * i).toFixed(2)}
          >
            {stat.countTo ? (
              <span
                class="studio-stat-value"
                data-count-to={stat.countTo}
                data-count-suffix={stat.suffix ?? ''}
              >
                0
              </span>
            ) : (
              <span class="studio-stat-value">{stat.value}</span>
            )}
            <span class="studio-stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>

    {/* ── Témoignages ────────────────────────────────── */}
    <div class="studio-block">
      <p class="studio-subhead" data-reveal>Ce qu'ils en disent</p>
      <div class="studio-testimonials">
        {testimonials.map((t, i) => (
          <figure
            class="studio-testimonial"
            data-reveal
            data-reveal-delay={(0.08 * i).toFixed(2)}
          >
            <span class="studio-testimonial-mark" aria-hidden="true">"</span>
            <blockquote class="studio-testimonial-text">{t.text}</blockquote>
            <figcaption class="studio-testimonial-author">
              <span class="studio-testimonial-avatar" aria-hidden="true">
                {t.initials}
              </span>
              <span>
                <span class="studio-testimonial-name">{t.name}</span>
                <span class="studio-testimonial-role">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    {/* ── Clients ────────────────────────────────────── */}
    <div class="studio-block">
      <p class="studio-subhead" data-reveal>Ils nous font confiance</p>
      <ul class="studio-clients">
        {clients.map((client, i) => (
          <li
            class="studio-client"
            data-reveal
            data-reveal-delay={(0.04 * i).toFixed(2)}
          >
            {client}
          </li>
        ))}
      </ul>
    </div>

    {/* ── CTA ────────────────────────────────────────── */}
    <div class="studio-cta-wrap" data-reveal>
      <a href="#contact" class="btn btn-primary">Travailler ensemble →</a>
    </div>
  </div>
</section>

<style>
  /* ── Header ───────────────────────────────────────── */
  .studio-header {
    margin-bottom: clamp(56px, 8vw, 88px);
  }

  /* ── Split : intro+features / stats ──────────────── */
  .studio-split {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
    margin-bottom: clamp(80px, 10vw, 120px);
  }

  @media (max-width: 900px) {
    .studio-split {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  .studio-intro {
    font-size: 16px;
    color: var(--color-muted);
    line-height: 2;
    margin-bottom: 36px;
    max-width: 56ch;
  }

  /* ── Features list ───────────────────────────────── */
  .studio-features {
    display: flex;
    flex-direction: column;
  }
  .studio-feature {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-border);
    transition: padding-left 0.4s var(--ease-out);
  }
  .studio-feature:first-child {
    border-top: 1px solid var(--color-border);
  }
  .studio-feature:hover {
    padding-left: 6px;
  }
  .studio-feature-num {
    font-family: var(--font-display);
    font-size: 11px;
    color: var(--color-red);
    letter-spacing: 2px;
    min-width: 28px;
    margin-top: 3px;
  }
  .studio-feature-title {
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 5px;
    color: var(--color-fg);
  }
  .studio-feature-desc {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.7;
  }

  /* ── Stats 2x2 ──────────────────────────────────── */
  .studio-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    align-self: center;
  }
  .studio-stat {
    background: rgba(20, 20, 24, 0.55);
    padding: clamp(36px, 4vw, 52px) clamp(24px, 3vw, 40px);
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
    transition: background 0.4s var(--ease-out);
  }
  .studio-stat:hover {
    background: rgba(26, 26, 31, 0.7);
  }
  .studio-stat-value {
    font-family: var(--font-display);
    font-size: clamp(48px, 5.5vw, 62px);
    color: var(--color-red);
    line-height: 1;
    margin-bottom: 10px;
    display: block;
    transition: letter-spacing 0.5s var(--ease-out);
  }
  .studio-stat:hover .studio-stat-value {
    letter-spacing: 4px;
  }
  .studio-stat-label {
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--color-muted);
    font-family: var(--font-label);
    display: block;
  }

  /* ── Sous-blocs (témoignages + clients) ───────────── */
  .studio-block {
    margin-bottom: clamp(72px, 9vw, 96px);
  }

  .studio-subhead {
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-muted-2);
    margin-bottom: 36px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
    font-weight: 600;
  }

  /* ── Témoignages ─────────────────────────────────── */
  .studio-testimonials {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  @media (max-width: 900px) {
    .studio-testimonials {
      grid-template-columns: 1fr;
    }
  }

  .studio-testimonial {
    background: rgba(20, 20, 24, 0.55);
    border: 1px solid var(--color-border);
    padding: 40px 36px;
    position: relative;
    overflow: hidden;
    transition: background 0.4s;
  }
  .studio-testimonial:hover {
    background: rgba(7, 7, 10, 0.7);
  }

  .studio-testimonial-mark {
    position: absolute;
    top: 18px;
    right: 28px;
    font-family: var(--font-display);
    font-size: 80px;
    color: rgba(208, 28, 28, 0.08);
    line-height: 1;
    pointer-events: none;
  }

  .studio-testimonial-text {
    font-size: 14.5px;
    color: var(--color-muted);
    line-height: 1.9;
    font-style: italic;
    margin-bottom: 28px;
    position: relative;
    z-index: 1;
  }

  .studio-testimonial-author {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .studio-testimonial-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-red);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--color-fg);
    flex-shrink: 0;
    letter-spacing: 1px;
  }
  .studio-testimonial-name {
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 700;
    display: block;
  }
  .studio-testimonial-role {
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: 1px;
    margin-top: 2px;
    display: block;
  }

  /* ── Clients ─────────────────────────────────────── */
  .studio-clients {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
  }

  @media (max-width: 768px) {
    .studio-clients {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 480px) {
    .studio-clients {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .studio-client {
    background: rgba(20, 20, 24, 0.4);
    border: 1px solid var(--color-border);
    padding: 28px 20px;
    text-align: center;
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-muted-2);
    transition: color 0.45s var(--ease-out), background 0.45s var(--ease-out);
    position: relative;
    overflow: hidden;
  }
  .studio-client::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-red);
    transform: scaleX(0);
    transition: transform 0.5s var(--ease-out);
  }
  .studio-client:hover {
    color: rgba(255, 255, 255, 0.7);
    background: rgba(26, 26, 31, 0.65);
  }
  .studio-client:hover::before {
    transform: scaleX(1);
  }

  /* ── CTA ─────────────────────────────────────────── */
  .studio-cta-wrap {
    text-align: center;
  }
</style>
